# Copy to .env next to docker-compose.yml (optional overrides).
# Do not commit real secrets.

POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password
POSTGRES_DB=erp
POSTGRES_PORT=5433
REDIS_PORT=6379

BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=3001

JWT_SECRET=change-me
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=default
DEFAULT_PASSWORD=default
PHOTO_URL=http://localhost:3000

# SMTP (used by backend + worker)
SMTP_EMAIL=
SMTP_PASSWORD=

# Browser-facing API URLs (baked into the frontend build)
VITE_APP_API_BASE_URL=http://localhost:3000/api
VITE_BACKEND_URL_STATIC=http://localhost:3000
VITE_APP_DEFAULT_ROUTE=/workbench
VITE_APP_PUBLIC_PATH=/
VITE_APP_ROUTER_MODE=backend