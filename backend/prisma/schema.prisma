// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  SUPERADMIN
  DIRECTOR
  PRINCIPAL
  TEACHER
  LIBRARIAN
  RECEPTIONIST
  ACCOUNTANT
  SCHOOL_ADMIN
  STUDENT
  PARENT
}
enum PaymentMode {
  CASH
  UPI
  ONLINE
  BANK_TRANSFER
  CHEQUE
  CARD
}
enum SessionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  LOCKED
}
enum LeaveType {
  CASUAL
  SICK
  DUTY
  MATERNITY
  PATERNITY
  UNPAID
}

enum FeeHeadType {
  ADMISSION
  TUITION
  HOSTEL
  TRANSPORT
  LAB
  EXAM
  SPORTS
  LIBRARY
  ACTIVITY
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String
  password     String
  role         Role     // ENUM: ADMIN | DIRECTOR | PRINCIPAL | TEACHER | LIBRARIAN | STUDENT | PARENT
  permissions  Json?
  createdAt    DateTime @default(now())

  // Relationships
  directorSchools     School[]       @relation("DirectorSchools")
  principalAssignment Branch?        @relation("PrincipalBranch")
  teacherClasses      ClassTeacher[]
  studentProfile      Student?       
  parentProfile       Parent?
  feeTransactions      FeeTransaction[]

}

model School {
  id         String   @id @default(uuid())
  name       String
  address    String
  createdBy  User     @relation("DirectorSchools", fields: [createdById], references: [id])
  createdById String

  branches   Branch[]
  students   Student[]
  academicSession AcademicSession[]
}

model Branch {
  id         String   @id @default(uuid())
  name       String
  school     School   @relation(fields: [schoolId], references: [id])
  schoolId   String

  principal  User?    @relation("PrincipalBranch", fields: [principalId], references: [id])
  principalId String? @unique
  classes    Class[]
}


model Student {
  id                   String   @id @default(uuid())
  user                 User     @relation( fields: [userId], references: [id])
  userId               String   @unique

  school               School @relation(fields: [schoolId], references: [id])
  schoolId             String
  branchId             String
  classId              String?
  sessionId            String?

  rollNo               String
  studentId            String

  // Fee tracking
  totalPayable         Float    @default(0)  // across all sessions
  totalPaid            Float    @default(0)
  balanceRemaining     Float    // totalPayable - totalPaid (auto-updated)

  feeDocs              FeeDoc[]
  feeTransactions      FeeTransaction[]
  enrollments Enrollment[]
  parentId             String
  parent               Parent @relation("ParentToStudent", fields: [parentId], references: [id])
}
model Parent {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  students  Student[] @relation("ParentToStudent")
}
model Class {
  id              String   @id @default(uuid())
  name            String
  branch          Branch   @relation(fields: [branchId], references: [id])
  branchId        String
  classTeacher    ClassTeacher[]
  enrollments Enrollment[]

}

model ClassTeacher {
  classId String
  teacherId String

  class   Class @relation(fields: [classId], references: [id])
  teacher User  @relation(fields: [teacherId], references: [id])

  @@id([classId, teacherId]) // composite key
}
model FeeDoc {
  id              String   @id @default(uuid())
  student         Student  @relation(fields: [studentId], references: [id])
  studentId       String

  session         AcademicSession @relation(fields: [sessionId], references: [id])
  sessionId       String

  admissionFee    Float
  tuitionFee      Float
  transportFee    Float
  hostelFee       Float
  concessions     Float   @default(0)

  totalPayable    Float   // derived from above
  paidInSession   Float   @default(0)  // updated when payment made for current year
  dueInSession    Float   // totalPayable - paidInSession

  createdAt       DateTime @default(now())
}

model FeeTransaction {
  id            String   @id @default(uuid())
  student       Student  @relation(fields: [studentId], references: [id])
  studentId     String

  amountPaid    Float
  paidOn        DateTime @default(now())
  remarks       String?
  mode          PaymentMode
  referenceId   String?

  appliedToDocIds String[] @default([]) // optional JSON array to store docIds it affected
  createdBy     User      @relation(fields: [createdById], references: [id])
  createdById   String
}
model AcademicSession {
  id         String    @id @default(uuid())
  name       String    // e.g., "2025–26"
  school     School    @relation(fields: [schoolId], references: [id])
  schoolId   String
  isCurrent  Boolean   @default(false)
  isLocked   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  enrollments Enrollment[]
  feeDocs    FeeDoc[]
}

model Enrollment {
  id         String    @id @default(uuid())
  student    Student   @relation(fields: [studentId], references: [id])
  studentId  String

  class      Class     @relation(fields: [classId], references: [id])
  classId    String

  session    AcademicSession @relation(fields: [sessionId], references: [id])
  sessionId  String

  rollNo     String?
  isPromoted Boolean   @default(false)
  createdAt  DateTime  @default(now())
}
