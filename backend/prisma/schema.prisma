generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  SUPERADMIN
  DIRECTOR
  PRINCIPAL
  TEACHER
  LIBRARIAN
  RECEPTIONIST
  ACCOUNTANT
  SCHOOL_ADMIN
  STUDENT
  FATHER
  MOTHER
}
enum PaymentMode {
  CASH
  UPI
  ONLINE
  BANK_TRANSFER
  CHEQUE
  CARD
}
enum SessionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  LOCKED
}
enum LeaveType {
  CASUAL
  SICK
  DUTY
  MATERNITY
  PATERNITY
  UNPAID
}

enum DiscountType {
  PERCENTAGE
  FIXED
}


enum FeeHeadType {
  ADMISSION
  TUITION
  HOSTEL
  TRANSPORT
  LAB
  EXAM
  SPORTS
  LIBRARY
  ACTIVITY
}
enum Permission {
  ALL

  // ---------- School ----------
  CREATE_SCHOOL
  VIEW_SCHOOL
  EDIT_SCHOOL
  DELETE_SCHOOL

  // ---------- Branch ----------
  CREATE_BRANCH
  VIEW_BRANCH
  EDIT_BRANCH
  DELETE_BRANCH

  // ---------- Class ----------
  CREATE_CLASS
  VIEW_CLASS
  EDIT_CLASS
  DELETE_CLASS
  CREATE_CLASSNAME
  VIEW_CLASSNAME

  // ---------- Student ----------
  CREATE_STUDENT
  VIEW_STUDENT
  EDIT_STUDENT
  DELETE_STUDENT
  BULK_UPLOAD_STUDENTS
  GET_BULK_UPLOAD_SHEET

  // ---------- Parent ----------
  CREATE_PARENT
  VIEW_PARENT
  EDIT_PARENT
  DELETE_PARENT

  // ---------- FeeHead ----------
  CREATE_FEE_HEAD
  VIEW_FEE_HEAD
  EDIT_FEE_HEAD
  DELETE_FEE_HEAD

  // ---------- FeeTemplate ----------
  CREATE_FEE_TEMPLATE
  VIEW_FEE_TEMPLATE
  EDIT_FEE_TEMPLATE
  DELETE_FEE_TEMPLATE

  // ---------- FeeDoc ----------
  GENERATE_FEE_DOCS
  VIEW_FEE_DOCS
  EDIT_FEE_DOC
  DELETE_FEE_DOC

  // ---------- FeePayment ----------
  CREATE_FEE_PAYMENT
  VIEW_FEE_PAYMENTS
  EDIT_FEE_PAYMENT
  DELETE_FEE_PAYMENT

  // ---------- FeeTransaction ----------
  CREATE_FEE_TRANSACTION
  VIEW_FEE_TRANSACTIONS
  VIEW_BRANCH_FEE_REPORT

  // ---------- Session ----------
  CREATE_SESSION
  VIEW_SESSION
  EDIT_SESSION
  DELETE_SESSION
  LOCK_SESSION
  PROMOTE_STUDENTS

  // ---------- DISCOUNT POLICY ----------
  CREATE_DISCOUNT_POLICY
  VIEW_DISCOUNT_POLICY
  UPDATE_DISCOUNT_POLICY
  DELETE_DISCOUNT_POLICY
  APPLY_DISCOUNT
  DELETE_APPLY_DISCOUNT
  VIEW_APPLY_DISCOUNT

  // ---------- Reports ----------
  VIEW_REPORTS
  EXPORT_REPORTS

  // ---------- Documents ----------
  GENERATE_ID_CARD
  GENERATE_TRANSFER_CERTIFICATE
  UPLOAD_DOCUMENT
  VIEW_DOCUMENT
  DELETE_DOCUMENT

  // ---------- Notifications ----------
  SEND_NOTIFICATION
  VIEW_NOTIFICATIONS
  DELETE_NOTIFICATION
}

enum ClassEnum {
  NURSERY
  LKG
  UKG
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH
  SIXTH
  SEVENTH
  EIGHTH
  NINTH
  TENTH
  ELEVENTH
  TWELFTH
}
model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  phone           String?
  password        String
  role            Role[]   @default([])
  permissions     Permission[] @default([])
  createdAt       DateTime @default(now())
  isPhoneVerified Boolean
  isEmailVerified Boolean

  // Relationships
  directorSchools     School[]       @relation("DirectorSchools")
  principalAssignment Branch?        @relation("PrincipalBranch")
  teacherClasses      ClassTeacher[]
  studentProfile      Student?       
  parents             Parent[]
  feeTransactions     FeeTransaction[]
}

model School {
  id          String   @id @default(uuid())
  name        String
  createdBy   User     @relation("DirectorSchools", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  branches    Branch[]
}

model Branch {
  id                String   @id @default(uuid())
  name              String
  address           String
  school            School   @relation(fields: [schoolId], references: [id])
  schoolId          String
  logoUrl           String?
  principal         User?    @relation("PrincipalBranch", fields: [principalId], references: [id])
  principalId       String?  @unique
  createdAt         DateTime @default(now())
  softwareCharge    Float    @default(0)
  classes           Class[]
  students          Student[]
  academicSession   AcademicSession[]
  sections          Section[]
  classLabels       ClassLabel[]
  discountsPolicies DiscountPolicy[]
}

model Student {
  id                   String   @id @default(uuid())
  user                 User?     @relation(fields: [userId], references: [id])
  userId               String?   @unique
  studentId            String?
  branchId             String 
  branch               Branch   @relation(fields: [branchId], references: [id])

  // ----- Personal Details -----
  name                 String
  admissionNo          String?
  gender               String?
  dob                  DateTime?
  aadhaar              String?
  birthCertificateUrl  String?
  abcId                String?
  sssmId               String?
  familySssmId         String?
  minority             String?
  scStObc              String?
  bpl                  String?
  scStObcCertificateUrl String?
  bplCertificateUrl    String?
  specialChild         Boolean? @default(false)
  allergies            String?
  studentEmail         String?
  studentMobile        String?
  citizenship          String?
  visaNo               String?
  visaType             String?
  visaValidity         DateTime?

  // ----- Previous Education -----
  previousSchoolName   String?
  previousClassPassed  String?
  previousClassMarks   String?
  previousClassYear    String?
  previousBoard        String?
  migrationCertificateUrl String?
  tcNo                 String?

  // ----- Address -----
  permanentAddress     String?
  temporaryAddress     String?

  // ----- Father Details -----
  fatherName           String?
  fatherOccupation     String?
  fatherEmail          String?
  fatherMobile         String?
  fatherAadhaar        String?
  fatherIdUrl          String?
  fatherPan            String?
  fatherPassport       String?
  fatherCitizenship    String?
  fatherVisaNo         String?
  fatherVisaType       String?
  fatherVisaValidity   DateTime?

  // ----- Mother Details -----
  motherName           String?
  motherOccupation     String?
  motherEmail          String?
  motherMobile         String?
  motherAadhaar        String?
  motherIdUrl          String?
  motherPan            String?
  motherPassport       String?
  motherCitizenship    String?
  motherVisaNo         String?
  motherVisaType       String?
  motherVisaValidity   DateTime?

  // ----- Extras -----
  result                Json?
  resultStatus          String?
  photoUrl              String?
  barcodeUrl            String?

  createdAt             DateTime @default(now())

  // Relationships
  enrollments           Enrollment[]
  fatherId              String?
  father                Parent?   @relation("fatherToStudent", fields: [fatherId], references: [id])
  motherId              String?
  mother                Parent?   @relation("motherToStudent", fields: [motherId], references: [id])
}

model Parent {
  id        String @id @default(uuid())
  type      String
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  fatherOf  Student[] @relation("fatherToStudent")
  motherOf  Student[] @relation("motherToStudent")
}

model Class {
  id             String   @id @default(uuid())
  classLabel     ClassLabel @relation(fields: [classLabelId], references: [id])
  classLabelId   String //isko optional nhi rkhna hain
  branch         Branch   @relation(fields: [branchId], references: [id])
  branchId       String
  createdAt      DateTime @default(now())

  classTeacher   ClassTeacher[]
  enrollments    Enrollment[]

  section     Section   @relation(fields: [sectionId], references: [id])
  sectionId   String // isko optional se hatana hain
}

model ClassLabel {
  id           String @id @default(uuid())
  name         String
  branch       Branch   @relation(fields: [branchId], references: [id])
  branchId     String
  classes      Class[]
  feeTemplates FeeTemplate[]
  createdAt    DateTime @default(now())
}

model Section {
  id        String   @id @default(uuid())
  name      String
  branch    Branch   @relation(fields: [branchId], references: [id])
  branchId  String
  createdAt DateTime @default(now())

  classes   Class[]   // optional: a section may have 0 or many classes
}


model ClassTeacher {
  classId   String
  teacherId String
  createdAt DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id])
  teacher User  @relation(fields: [teacherId], references: [id])

  @@id([classId, teacherId])
}


model AcademicSession {
  id          String         @id @default(uuid())
  name        String         // e.g., "2025–26"
  branch      Branch         @relation(fields: [branchId], references: [id])
  branchId    String
  isCurrent   Boolean        @default(false)
  isLocked    Boolean        @default(false)
  createdAt   DateTime       @default(now())

  months      AcademicMonth[] @relation("academicMonths")
  startMonth  AcademicMonth @relation("SessionStartMonth", fields: [startMonthId], references: [id])
  startMonthId String      @unique
  endMonth    AcademicMonth @relation("SessionEndMonth", fields: [endMonthId], references: [id])
  endMonthId   String       @unique

  enrollments    Enrollment[]
  feeTemplates   FeeTemplate[]
}

model AcademicMonth {
  id          String          @id @default(uuid())
  name        String          // July, August, etc.
  startDate   DateTime
  endDate     DateTime
  session     AcademicSession @relation("academicMonths", fields: [sessionId], references: [id])
  sessionId   String

  AcademicSessionStart AcademicSession? @relation("SessionStartMonth")

  AcademicSessionEnd AcademicSession?  @relation("SessionEndMonth")

  feePayment  FeePayment?
}


model Enrollment {
  id                      String    @id @default(uuid())
  student                 Student   @relation(fields: [studentId], references: [id])
  studentId               String
  class                   Class     @relation(fields: [classId], references: [id])
  classId                 String
  session                 AcademicSession @relation(fields: [sessionId], references: [id])
  sessionId               String
  rollNo                  String
  feeDocs                 FeeDoc[] 
  feeTransactions         FeeTransaction[]
  isPromoted Boolean      @default(false)
  createdAt  DateTime     @default(now())
}


enum FeePaymentType {
  MONTHLY
  INSTALLMENT
  ONE_TIME
}

model FeeHead {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  feeTemplates FeeTemplate[]
  feeDocs      FeeDoc[]
}

model FeeTemplate {
  id              String   @id @default(uuid())
  session         AcademicSession @relation(fields: [sessionId], references: [id])
  sessionId       String
  branchId        String
  classLabel      ClassLabel @relation(fields: [classLabelId], references: [id])
  classLabelId    String
    
  feeHeadId       String
  feeHead         FeeHead  @relation(fields: [feeHeadId], references: [id])
    
  amount          Float
  discounts       Discount[]     // optional default discounts
  lateFees        LateFee[]      // optional default late fees
  feeDocs         FeeDoc[]       // generated per student

  paymentType     FeePaymentType @default(ONE_TIME)     //isko isliye rkh rhe hain as jab bahut sare student ko default payment kaise krenge wo krna hain tb  
  installements   Float?         // jab user payment type installments choose krega tab kitni installments banegi uske liye
  dueDate         DateTime @default(now())  // due date bhi honi chahiye na har payment ke liye
  createdAt       DateTime @default(now())
}

model FeeDoc {
  id               String       @id @default(uuid())
  eenrollment      Enrollment @relation(fields: [enrollmentId], references: [id])
  enrollmentId     String

  templateId       String?
  template         FeeTemplate? @relation(fields: [templateId], references: [id])
   
  feeHeadId        String
  feeHead          FeeHead  @relation(fields: [feeHeadId], references: [id])
   
  paymentType      FeePaymentType
  amount           Float
  afterAmount      Float    @default(0)    //amount after deducting discounts and late fees
  status           String   @default("PENDING") // Pending | Partial | Paid
   
  payments         FeePayment[] // linked payment schedules
  transactions     FeeTransactionItem[]
  discounts        Discount[]
  lateFees         LateFee[]
   
  createdAt        DateTime @default(now())
}

model FeePayment {
  id                 String   @id @default(uuid())
  feeDocId           String
  feeDoc             FeeDoc   @relation(fields: [feeDocId], references: [id])
   
  academicMonthId    String? @unique  // if monthly, link to academic month
  academicMonth      AcademicMonth? @relation(fields: [academicMonthId], references: [id])
   
  name               String?   // "July installment" / "Admission Fee"
  amount             Float
  dueDate            DateTime
  isPaid             Boolean   @default(false)
  fineAmount         Float     @default(0)
  lateFees           LateFee[]
  paidAmount         Float     @default(0)
  createdAt          DateTime @default(now())
}   

model FeeTransaction {
  id             String   @id @default(uuid())

  enrollmentId   String
  enrollment     Enrollment  @relation(fields: [enrollmentId], references: [id])

  amountPaid     Float
  returnedAmt    Float    @default(0)
  paidOn         DateTime @default(now())
  remarks        String?

  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])

  // Relations
  items          FeeTransactionItem[]
  discounts      Discount[]
  lateFees       LateFee[]

  mode           PaymentMode
  referenceId    String?        // txn id, cheque no, UPI ref
  receiptNo      String         @unique
}

model FeeTransactionItem {
  id            String   @id @default(uuid())
  transactionId String
  transaction   FeeTransaction @relation(fields: [transactionId], references: [id])

  feeDocId      String
  feeDoc        FeeDoc @relation(fields: [feeDocId], references: [id])

  paidAmount    Float
}

model DiscountPolicy {
  id            String   @id @default(uuid())
  name          String
  description   String?
  discountType  DiscountType
  discounts     Discount[]
  branchId      String
  branch        Branch @relation(fields: [branchId], references: [id])
  percentage    Float?
  amount        Float?
  usageLimit    Int?
  expiryDate    DateTime?
  createdAt     DateTime @default(now())
}

model Discount {
  id             String   @id @default(uuid())
  feeDocId       String?
  feeDoc         FeeDoc? @relation(fields: [feeDocId], references: [id])
  transactionId  String?
  transaction    FeeTransaction? @relation(fields: [transactionId], references: [id])
  feeTemplateId  String?
  feeTemplate    FeeTemplate?    @relation(fields: [feeTemplateId], references: [id])

  policyId       String?
  policy         DiscountPolicy? @relation(fields: [policyId], references: [id])

  appliedAmount  Float   // final computed discount (percentage → converted to fixed)
  createdAt      DateTime @default(now())
}

model LateFee {
  id            String   @id @default(uuid())
  feeDocId      String?
  feeDoc        FeeDoc? @relation(fields: [feeDocId], references: [id])
  feeTemplateId String?
  feeTemplate   FeeTemplate? @relation(fields: [feeTemplateId], references: [id])
  transactionId String?
  transaction   FeeTransaction? @relation(fields: [transactionId], references: [id])
  paymentId     String?
  payment       FeePayment?   @relation(fields: [paymentId], references: [id])
  amount        Float
  reason        String?
}



