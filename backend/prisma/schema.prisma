// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  SUPERADMIN
  DIRECTOR
  PRINCIPAL
  TEACHER
  LIBRARIAN
  RECEPTIONIST
  ACCOUNTANT
  SCHOOL_ADMIN
  STUDENT
  FATHER
  MOTHER
}
enum PaymentMode {
  CASH
  UPI
  ONLINE
  BANK_TRANSFER
  CHEQUE
  CARD
}
enum SessionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  LOCKED
}
enum LeaveType {
  CASUAL
  SICK
  DUTY
  MATERNITY
  PATERNITY
  UNPAID
}

enum FeeHeadType {
  ADMISSION
  TUITION
  HOSTEL
  TRANSPORT
  LAB
  EXAM
  SPORTS
  LIBRARY
  ACTIVITY
}
enum Permission {
  ALL
  // School
  CREATE_SCHOOL
  VIEW_SCHOOL
  EDIT_SCHOOL
  DELETE_SCHOOL

  // Branch
  CREATE_BRANCH
  VIEW_BRANCH
  EDIT_BRANCH
  DELETE_BRANCH

  // Class
  CREATE_CLASS
  VIEW_CLASS
  EDIT_CLASS
  DELETE_CLASS
  VIEW_CLASSNAME
	CREATE_CLASSNAME 

  // Student
  CREATE_STUDENT
  VIEW_STUDENT
  EDIT_STUDENT
  DELETE_STUDENT
  BULK_UPLOAD_STUDENTS
  GET_BULK_UPLOAD_SHEET

  // Parent
  CREATE_PARENT
  VIEW_PARENT
  EDIT_PARENT
  DELETE_PARENT

  // Fees
  CREATE_FEE_DOC
  VIEW_FEE_DOC
  EDIT_FEE_DOC
  DELETE_FEE_DOC
  RECORD_FEE_TRANSACTION
  VIEW_FEE_SUMMARY

  // Session
  CREATE_SESSION
  VIEW_SESSION
  EDIT_SESSION
  LOCK_SESSION
  PROMOTE_STUDENTS

  // Reports
  VIEW_REPORTS
  EXPORT_REPORTS

  // Documents
  GENERATE_ID_CARD
  GENERATE_TRANSFER_CERTIFICATE

  // Notifications
  SEND_NOTIFICATION
  VIEW_NOTIFICATIONS
}
enum ClassEnum {
  NURSERY
  LKG
  UKG
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH
  SIXTH
  SEVENTH
  EIGHTH
  NINTH
  TENTH
  ELEVENTH
  TWELFTH
}
model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  phone           String?
  password        String
  role            Role[]   @default([])
  permissions     Permission[] @default([])
  createdAt       DateTime @default(now())
  isPhoneVerified Boolean
  isEmailVerified Boolean

  // Relationships
  directorSchools     School[]       @relation("DirectorSchools")
  principalAssignment Branch?        @relation("PrincipalBranch")
  teacherClasses      ClassTeacher[]
  studentProfile      Student?       
  parents             Parent[]
  feeTransactions     FeeTransaction[]
}

model School {
  id          String   @id @default(uuid())
  name        String
  createdBy   User     @relation("DirectorSchools", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  branches    Branch[]
}

model Branch {
  id              String   @id @default(uuid())
  name            String
  address         String
  school          School   @relation(fields: [schoolId], references: [id])
  schoolId        String
  logoUrl         String?
  principal       User?    @relation("PrincipalBranch", fields: [principalId], references: [id])
  principalId     String?  @unique
  createdAt       DateTime @default(now())
  softwareCharge  Float    @default(0)
  classes         Class[]
  students        Student[]
  academicSession AcademicSession[]
  sections        Section[]
  classLabels     ClassLabel[]
}

model Student {
  id                   String   @id @default(uuid())
  user                 User?     @relation(fields: [userId], references: [id])
  userId               String?   @unique
  studentId            String?
  branchId             String 
  branch               Branch   @relation(fields: [branchId], references: [id])
  rollNo               String

  // ----- Personal Details -----
  name                 String
  admissionNo          String?
  class                ClassEnum? // isko hatana hain as class -> className+section and we need enrollment things too so keeping its class as it is in student table in wrong
  section              String?
  gender               String?
  dob                  DateTime?
  aadhaar              String?
  birthCertificateUrl  String?
  abcId                String?
  sssmId               String?
  familySssmId         String?
  minority             String?
  scStObc              String?
  bpl                  String?
  scStObcCertificateUrl String?
  bplCertificateUrl    String?
  specialChild         Boolean? @default(false)
  allergies            String?
  studentEmail         String?
  studentMobile        String?
  citizenship          String?
  visaNo               String?
  visaType             String?
  visaValidity         DateTime?

  // ----- Previous Education -----
  previousSchoolName   String?
  previousClassPassed  String?
  previousClassMarks   String?
  previousClassYear    String?
  previousBoard        String?
  migrationCertificateUrl String?
  tcNo                 String?

  // ----- Address -----
  permanentAddress     String?
  temporaryAddress     String?

  // ----- Father Details -----
  fatherName           String?
  fatherOccupation     String?
  fatherEmail          String?
  fatherMobile         String?
  fatherAadhaar        String?
  fatherIdUrl          String?
  fatherPan            String?
  fatherPassport       String?
  fatherCitizenship    String?
  fatherVisaNo         String?
  fatherVisaType       String?
  fatherVisaValidity   DateTime?

  // ----- Mother Details -----
  motherName           String?
  motherOccupation     String?
  motherEmail          String?
  motherMobile         String?
  motherAadhaar        String?
  motherIdUrl          String?
  motherPan            String?
  motherPassport       String?
  motherCitizenship    String?
  motherVisaNo         String?
  motherVisaType       String?
  motherVisaValidity   DateTime?

  // ----- Fees -----
  discount             Float    @default(0)
  lateFine             Float    @default(0)
  remark               String?

  // Current year fee tracking
  currentYearTotal         Float    @default(0)
  currentYearTotalPaid     Float    @default(0)
  currentYearTotalBalance  Float    @default(0)

  // Last year fee tracking
  lastYearTotal            Float    @default(0)
  lastYearTotalPaid        Float    @default(0)
  lastYearTotalBalance     Float    @default(0)

  // ----- Extras -----
  result                Json?
  resultStatus          String?
  photoUrl              String?
  barcodeUrl            String?

  createdAt             DateTime @default(now())

  // Relationships
  enrollments           Enrollment[]
  fatherId              String?
  father                Parent?   @relation("fatherToStudent", fields: [fatherId], references: [id])
  motherId              String?
  mother                Parent?   @relation("motherToStudent", fields: [motherId], references: [id])
}

model Parent {
  id        String @id @default(uuid())
  type      String
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  fatherOf  Student[] @relation("fatherToStudent")
  motherOf  Student[] @relation("motherToStudent")
}

model Class {
  id             String   @id @default(uuid())
  classLabel     ClassLabel @relation(fields: [classLabelId], references: [id])
  classLabelId   String //isko optional nhi rkhna hain
  branch         Branch   @relation(fields: [branchId], references: [id])
  branchId       String
  createdAt      DateTime @default(now())

  classTeacher   ClassTeacher[]
  enrollments    Enrollment[]

  section     Section   @relation(fields: [sectionId], references: [id])
  sectionId   String // isko optional se hatana hain
}

model ClassLabel {
  id           String @id @default(uuid())
  name         String
  branch       Branch   @relation(fields: [branchId], references: [id])
  branchId     String
  classes      Class[]
  feeTemplates FeeTemplate[]
  createdAt    DateTime @default(now())
}

model Section {
  id        String   @id @default(uuid())
  name      String
  branch    Branch   @relation(fields: [branchId], references: [id])
  branchId  String
  createdAt DateTime @default(now())

  classes   Class[]   // optional: a section may have 0 or many classes
}


model ClassTeacher {
  classId   String
  teacherId String
  createdAt DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id])
  teacher User  @relation(fields: [teacherId], references: [id])

  @@id([classId, teacherId])
}


model AcademicSession {
  id         String    @id @default(uuid())
  name       String
  branch     Branch    @relation(fields: [branchId], references: [id])
  branchId   String
  isCurrent  Boolean   @default(false)
  isLocked   Boolean   @default(false)
  createdAt  DateTime  @default(now())

  enrollments Enrollment[]
  feeTemplates     FeeTemplate[]
  academicsMonths AcademicMonth[]
}

model Enrollment {
  id                      String    @id @default(uuid())
  student                 Student   @relation(fields: [studentId], references: [id])
  studentId               String
  class                   Class     @relation(fields: [classId], references: [id])
  classId                 String
  session                 AcademicSession @relation(fields: [sessionId], references: [id])
  sessionId               String
  rollNo                  String?
  feeDocs                 FeeDoc[] 
  feeTransactions         FeeTransaction[]
  isPromoted Boolean      @default(false)
  createdAt  DateTime     @default(now())
}


enum FeePaymentType {
  MONTHLY
  INSTALLMENT
  ONE_TIME
}

model FeeHead {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  feeTemplates FeeTemplate[]
  feeDocs      FeeDoc[]
}

model FeeTemplate {
  id              String   @id @default(uuid())
  session         AcademicSession @relation(fields: [sessionId], references: [id])
  sessionId       String
  branchId        String
  classLabel      ClassLabel @relation(fields: [classLabelId], references: [id])
  classLabelId    String
    
  feeHeadId       String
  feeHead         FeeHead  @relation(fields: [feeHeadId], references: [id])
    
  amount          Float
  discounts       Discount[]     // optional default discounts
  lateFees        LateFee[]      // optional default late fees
  feeDocs         FeeDoc[]       // generated per student
    
  createdAt       DateTime @default(now())
}

model FeeDoc {
  id               String       @id @default(uuid())
  eenrollment      Enrollment @relation(fields: [enrollmentId], references: [id])
  enrollmentId     String

  templateId       String?
  template         FeeTemplate? @relation(fields: [templateId], references: [id])
   
  feeHeadId        String
  feeHead          FeeHead  @relation(fields: [feeHeadId], references: [id])
   
  paymentType      FeePaymentType
  amount           Float
  status           String   @default("PENDING") // Pending | Partial | Paid
   
  payments         FeePayment[] // linked payment schedules
  transactions     FeeTransactionItem[]
  discounts        Discount[]
  lateFees         LateFee[]
   
  createdAt        DateTime @default(now())
}

model FeePayment {
  id          String   @id @default(uuid())
  feeDocId    String
  feeDoc      FeeDoc   @relation(fields: [feeDocId], references: [id])

  academicMonthId String? @unique  // if monthly, link to academic month
  academicMonth   AcademicMonth? @relation(fields: [academicMonthId], references: [id])

  name        String?   // "July installment" / "Admission Fee"
  amount      Float
  dueDate     DateTime
  isPaid      Boolean   @default(false)

  createdAt   DateTime @default(now())
}

model FeeTransaction {
  id             String   @id @default(uuid())

  enrollmentId   String
  enrollment     Enrollment  @relation(fields: [enrollmentId], references: [id])

  amountPaid     Float
  paidOn         DateTime @default(now())
  remarks        String?

  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])

  // Relations
  items          FeeTransactionItem[]
  discounts      Discount[]
  lateFees       LateFee[]

  mode           PaymentMode
  referenceId    String?        // txn id, cheque no, UPI ref
  receiptNo      String         @unique
}

model FeeTransactionItem {
  id            String   @id @default(uuid())
  transactionId String
  transaction   FeeTransaction @relation(fields: [transactionId], references: [id])

  feeDocId      String
  feeDoc        FeeDoc @relation(fields: [feeDocId], references: [id])

  paidAmount    Float
}

model Discount {
  id            String   @id @default(uuid())
  feeDocId      String
  feeDoc        FeeDoc @relation(fields: [feeDocId], references: [id])
  feeTemplateId String
  feeTemplate   FeeTemplate @relation(fields: [feeTemplateId], references: [id])
  transactionId String?
  transaction   FeeTransaction? @relation(fields: [transactionId], references: [id])

  type          String   // e.g., "Sibling", "Merit"
  amount        Float
}

model LateFee {
  id            String   @id @default(uuid())
  feeDocId      String
  feeDoc        FeeDoc @relation(fields: [feeDocId], references: [id])
  feeTemplateId String
  feeTemplate   FeeTemplate @relation(fields: [feeTemplateId], references: [id])
  transactionId String?
  transaction   FeeTransaction? @relation(fields: [transactionId], references: [id])

  amount        Float
  reason        String?
}

model AcademicMonth {
  id         String   @id @default(uuid())
  name       String   // July, August, etc.
  startDate  DateTime
  endDate    DateTime
  sessionId  String
  feePayment  FeePayment?
  session    AcademicSession @relation(fields: [sessionId], references: [id])
}


