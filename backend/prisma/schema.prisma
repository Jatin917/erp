generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  name                    String
  email                   String                   @unique
  phone                   String?
  password                String
  role                    Role[]                   @default([])
  createdAt               DateTime                 @default(now())
  isPhoneVerified         Boolean
  isEmailVerified         Boolean
  permissions             Permission[]             @default([])
  markedAttendance        Attendance?
  attendanceAuditALog     AttendanceAuditLog?
  principalAssignment     Branch?                  @relation("PrincipalBranch")
  teacherClasses          ClassTeacher[]
  customFields            CustomField[]
  feeTransactions         FeeTransaction[]
  parents                 Parent[]
  directorSchools         School[]                 @relation("DirectorSchools")
  markedTeacherAttendance SchoolFacultyAttendance?
  studentProfile          Student?
  schoolFaculty           SchoolFaculty?
}

model School {
  id          String   @id @default(uuid())
  name        String
  createdById String
  createdAt   DateTime @default(now())
  branches    Branch[]
  createdBy   User     @relation("DirectorSchools", fields: [createdById], references: [id])
}

model Branch {
  id                String            @id @default(uuid())
  name              String
  schoolId          String
  principalId       String?           @unique
  address           String
  logoUrl           String?
  createdAt         DateTime          @default(now())
  softwareCharge    Float             @default(0)
  academicSession   AcademicSession[]
  principal         User?             @relation("PrincipalBranch", fields: [principalId], references: [id])
  school            School            @relation(fields: [schoolId], references: [id])
  classes           Class[]
  classLabels       ClassLabel[]
  customFields      CustomField[]
  discountsPolicies DiscountPolicy[]
  teachers          SchoolFaculty[]
  sections          Section[]
  students          Student[]
}

model Student {
  id                      String       @id @default(uuid())
  userId                  String?      @unique
  branchId                String
  aadhaar                 String?
  abcId                   String?
  admissionNo             String?
  allergies               String?
  barcodeUrl              String?
  birthCertificateUrl     String?
  bpl                     String?
  bplCertificateUrl       String?
  citizenship             String?
  dob                     DateTime?
  familySssmId            String?
  fatherAadhaar           String?
  fatherCitizenship       String?
  fatherEmail             String?
  fatherIdUrl             String?
  fatherMobile            String?
  fatherName              String?
  fatherOccupation        String?
  fatherPan               String?
  fatherPassport          String?
  fatherVisaNo            String?
  fatherVisaType          String?
  fatherVisaValidity      DateTime?
  gender                  String?
  migrationCertificateUrl String?
  minority                String?
  motherAadhaar           String?
  motherCitizenship       String?
  motherEmail             String?
  motherIdUrl             String?
  motherMobile            String?
  motherName              String?
  motherOccupation        String?
  motherPan               String?
  motherPassport          String?
  motherVisaNo            String?
  motherVisaType          String?
  motherVisaValidity      DateTime?
  permanentAddress        String?
  photoUrl                String?
  previousBoard           String?
  previousClassMarks      String?
  previousClassPassed     String?
  previousClassYear       String?
  previousSchoolName      String?
  result                  Json?
  resultStatus            String?
  scStObc                 String?
  scStObcCertificateUrl   String?
  specialChild            Boolean?     @default(false)
  sssmId                  String?
  studentEmail            String?
  studentMobile           String?
  tcNo                    String?
  temporaryAddress        String?
  visaNo                  String?
  visaType                String?
  visaValidity            DateTime?
  studentId               String?
  fatherId                String?
  motherId                String?
  name                    String
  createdAt               DateTime     @default(now())
  enrollments             Enrollment[]
  branch                  Branch       @relation(fields: [branchId], references: [id])
  father                  Parent?      @relation("fatherToStudent", fields: [fatherId], references: [id])
  mother                  Parent?      @relation("motherToStudent", fields: [motherId], references: [id])
  user                    User?        @relation(fields: [userId], references: [id])
}

model CustomField {
  id                String             @id @default(uuid())
  entityType        ENTITES
  name              String
  label             String
  options           Json?
  required          Boolean            @default(false)
  regex             String?
  minLength         Int?
  maxLength         Int?
  branchId          String
  createdById       String
  createdAt         DateTime           @default(now())
  type              customFieldType
  branch            Branch             @relation(fields: [branchId], references: [id])
  createdBy         User               @relation(fields: [createdById], references: [id])
  customFieldValues CustomFieldValue[]
}

model CustomFieldValue {
  id            String      @id @default(uuid())
  customFieldId String
  entityType    ENTITES
  entityId      String
  value         String
  createdAt     DateTime    @default(now())
  customField   CustomField @relation(fields: [customFieldId], references: [id])
}

model Parent {
  id        String    @id @default(uuid())
  type      String
  userId    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  fatherOf  Student[] @relation("fatherToStudent")
  motherOf  Student[] @relation("motherToStudent")
}

model Class {
  id           String         @id @default(uuid())
  branchId     String
  createdAt    DateTime       @default(now())
  sectionId    String
  classLabelId String
  branch       Branch         @relation(fields: [branchId], references: [id])
  classLabel   ClassLabel     @relation(fields: [classLabelId], references: [id])
  section      Section        @relation(fields: [sectionId], references: [id])
  classTeacher ClassTeacher[]
  enrollments  Enrollment[]
  lectures     Lecture[]
  subjects     Subject[]
}

model ClassLabel {
  id           String        @id @default(uuid())
  name         String
  branchId     String
  createdAt    DateTime      @default(now())
  classes      Class[]
  branch       Branch        @relation(fields: [branchId], references: [id])
  feeTemplates FeeTemplate[]

  @@unique([branchId, name])
}

model Section {
  id        String   @id @default(uuid())
  name      String
  branchId  String
  createdAt DateTime @default(now())
  classes   Class[]
  branch    Branch   @relation(fields: [branchId], references: [id])
}

model ClassTeacher {
  classId   String
  teacherId String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])
  teacher   User     @relation(fields: [teacherId], references: [id])

  @@id([classId, teacherId])
}

model AcademicSession {
  id           String          @id @default(uuid())
  name         String
  isCurrent    Boolean         @default(false)
  isLocked     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  branchId     String
  endMonthId   String?         @unique
  startMonthId String?         @unique
  months       AcademicMonth[] @relation("academicMonths")
  branch       Branch          @relation(fields: [branchId], references: [id])
  endMonth     AcademicMonth?  @relation("SessionEndMonth", fields: [endMonthId], references: [id])
  startMonth   AcademicMonth?  @relation("SessionStartMonth", fields: [startMonthId], references: [id])
  enrollments  Enrollment[]
  feeTemplates FeeTemplate[]
  schoolDays   SchoolDay[]
}

model AcademicMonth {
  id                   String           @id @default(uuid())
  name                 String
  startDate            DateTime
  endDate              DateTime
  sessionId            String
  session              AcademicSession  @relation("academicMonths", fields: [sessionId], references: [id])
  AcademicSessionEnd   AcademicSession? @relation("SessionEndMonth")
  AcademicSessionStart AcademicSession? @relation("SessionStartMonth")
  feePayment           FeePayment?
}

model Enrollment {
  id              String           @id @default(uuid())
  studentId       String
  classId         String
  sessionId       String
  rollNo          String
  isPromoted      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  attendances     Attendance[]
  class           Class            @relation(fields: [classId], references: [id])
  session         AcademicSession  @relation(fields: [sessionId], references: [id])
  student         Student          @relation(fields: [studentId], references: [id])
  feeDocs         FeeDoc[]
  feeTransactions FeeTransaction[]
}

model FeeHead {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now())
  feeDocs      FeeDoc[]
  feeTemplates FeeTemplate[]
}

model FeeTemplate {
  id            String          @id @default(uuid())
  sessionId     String
  branchId      String
  classLabelId  String
  feeHeadId     String
  amount        Float
  createdAt     DateTime        @default(now())
  dueDate       DateTime        @default(now())
  installements Float?
  paymentType   FeePaymentType  @default(ONE_TIME)
  discounts     Discount[]
  feeDocs       FeeDoc[]
  classLabel    ClassLabel      @relation(fields: [classLabelId], references: [id])
  feeHead       FeeHead         @relation(fields: [feeHeadId], references: [id])
  session       AcademicSession @relation(fields: [sessionId], references: [id])
  lateFees      LateFee[]
}

model FeeDoc {
  id           String               @id @default(uuid())
  createdAt    DateTime             @default(now())
  amount       Float
  enrollmentId String
  feeHeadId    String
  paymentType  FeePaymentType
  templateId   String?
  afterAmount  Float                @default(0)
  status       PaymentStatus        @default(PENDING)
  discounts    Discount[]
  eenrollment  Enrollment           @relation(fields: [enrollmentId], references: [id])
  feeHead      FeeHead              @relation(fields: [feeHeadId], references: [id])
  template     FeeTemplate?         @relation(fields: [templateId], references: [id])
  payments     FeePayment[]
  transactions FeeTransactionItem[]
  lateFees     LateFee[]
}

model FeePayment {
  id              String                 @id @default(uuid())
  feeDocId        String
  academicMonthId String?                @unique
  name            String?
  amount          Float
  dueDate         DateTime
  isPaid          Boolean                @default(false)
  createdAt       DateTime               @default(now())
  paidAmount      Float                  @default(0)
  fineAmount      Float                  @default(0)
  academicMonth   AcademicMonth?         @relation(fields: [academicMonthId], references: [id])
  feeDoc          FeeDoc                 @relation(fields: [feeDocId], references: [id])
  feeAllocations  FeePaymentAllocation[]
  lateFees        LateFee[]
}

model FeeTransaction {
  id             String                 @id @default(uuid())
  amountPaid     Float
  paidOn         DateTime               @default(now())
  remarks        String?
  createdById    String
  enrollmentId   String
  mode           PaymentMode
  receiptNo      String                 @unique
  referenceId    String?
  returnedAmt    Float                  @default(0)
  discounts      Discount[]
  feeAllocations FeePaymentAllocation[]
  createdBy      User                   @relation(fields: [createdById], references: [id])
  enrollment     Enrollment             @relation(fields: [enrollmentId], references: [id])
  items          FeeTransactionItem[]
  lateFees       LateFee[]
}

model FeeTransactionItem {
  id            String         @id @default(uuid())
  transactionId String
  feeDocId      String
  paidAmount    Float
  feeDoc        FeeDoc         @relation(fields: [feeDocId], references: [id])
  transaction   FeeTransaction @relation(fields: [transactionId], references: [id])
}

model FeePaymentAllocation {
  id              String         @id @default(uuid())
  feePaymentId    String
  transactionId   String
  allocatedAmount Float
  createdAt       DateTime       @default(now())
  feePayment      FeePayment     @relation(fields: [feePaymentId], references: [id])
  transaction     FeeTransaction @relation(fields: [transactionId], references: [id])
}

model DiscountPolicy {
  id           String       @id @default(uuid())
  name         String
  description  String?
  discountType DiscountType
  percentage   Float?
  amount       Float?
  usageLimit   Int?
  expiryDate   DateTime?
  createdAt    DateTime     @default(now())
  branchId     String
  discounts    Discount[]
  branch       Branch       @relation(fields: [branchId], references: [id])
}

model Discount {
  id            String          @id @default(uuid())
  feeDocId      String?
  feeTemplateId String?
  transactionId String?
  appliedAmount Float
  createdAt     DateTime        @default(now())
  policyId      String?
  feeDoc        FeeDoc?         @relation(fields: [feeDocId], references: [id])
  feeTemplate   FeeTemplate?    @relation(fields: [feeTemplateId], references: [id])
  policy        DiscountPolicy? @relation(fields: [policyId], references: [id])
  transaction   FeeTransaction? @relation(fields: [transactionId], references: [id])
}

model LateFee {
  id            String          @id @default(uuid())
  feeDocId      String?
  feeTemplateId String?
  transactionId String?
  amount        Float
  reason        String?
  paymentId     String?
  feeDoc        FeeDoc?         @relation(fields: [feeDocId], references: [id])
  feeTemplate   FeeTemplate?    @relation(fields: [feeTemplateId], references: [id])
  payment       FeePayment?     @relation(fields: [paymentId], references: [id])
  transaction   FeeTransaction? @relation(fields: [transactionId], references: [id])
}

model SchoolFaculty {
  id          String                    @id @default(uuid())
  userid      String                    @unique @default("1d04d74e-2e18-4d9e-a1c2-6c65e9d65d42")
  user        User                      @relation(fields: [userid], references: [id])
  name        String
  branchId    String
  createdAt   DateTime                  @default(now())
  lectures    Lecture[]
  branch      Branch                    @relation(fields: [branchId], references: [id])
  attendances SchoolFacultyAttendance[]
}

model SchoolFacultyAttendance {
  id          String           @id @default(uuid())
  teacherId   String
  schoolDayId String
  lectureId   String?
  type        AttendanceType
  status      AttendanceStatus
  reason      String?
  markedById  String?          @unique
  markedAt    DateTime         @default(now())
  lecture     Lecture?         @relation(fields: [lectureId], references: [id])
  markedBy    User?            @relation(fields: [markedById], references: [id])
  schoolDay   SchoolDay        @relation(fields: [schoolDayId], references: [id])
  teacher     SchoolFaculty    @relation(fields: [teacherId], references: [id])
}

model SchoolDay {
  id                 String                    @id @default(uuid())
  date               DateTime
  sessionId          String
  type               SchoolDayType
  attendances        Attendance[]
  lectures           Lecture[]
  session            AcademicSession           @relation(fields: [sessionId], references: [id])
  teacherAttendances SchoolFacultyAttendance[]
}

model Subject {
  id       String    @id @default(uuid())
  name     String
  classId  String
  lectures Lecture[]
  class    Class     @relation(fields: [classId], references: [id])
  createdAt DateTime @default(now())

  @@unique([classId, name])
}

model Lecture {
  id                 String                    @id @default(uuid())
  classId            String
  subjectId          String
  teacherId          String
  dayOfWeek          Weekday
  schoolDayId        String
  startTime          String
  endTime            String
  attendances        Attendance[]
  auditAttendanceLog AttendanceAuditLog?
  class              Class                     @relation(fields: [classId], references: [id])
  schoolDay          SchoolDay                 @relation(fields: [schoolDayId], references: [id])
  subject            Subject                   @relation(fields: [subjectId], references: [id])
  teacher            SchoolFaculty             @relation(fields: [teacherId], references: [id])
  teacherAttendances SchoolFacultyAttendance[]
  status             LectureStatus
}

model Attendance {
  id           String           @id @default(uuid())
  enrollmentId String
  schoolDayId  String
  lectureId    String?
  type         AttendanceType
  status       AttendanceStatus
  method       AttendanceMethod
  markedById   String?          @unique
  markedAt     DateTime         @default(now())
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id])
  lecture      Lecture?         @relation(fields: [lectureId], references: [id])
  markedBy     User?            @relation(fields: [markedById], references: [id])
  schoolDay    SchoolDay        @relation(fields: [schoolDayId], references: [id])
}

model AttendanceAuditLog {
  id            String   @id @default(uuid())
  lectureId     String   @unique
  action        String
  performedById String   @unique
  remarks       String?
  createdAt     DateTime @default(now())
  lecture       Lecture  @relation(fields: [lectureId], references: [id])
  performedBy   User     @relation(fields: [performedById], references: [id])
}

enum Role {
  SUPERADMIN
  DIRECTOR
  PRINCIPAL
  TEACHER
  LIBRARIAN
  RECEPTIONIST
  ACCOUNTANT
  SCHOOL_ADMIN
  STUDENT
  FATHER
  MOTHER
}

enum SchoolFacultyRole {
  TEACHER
  LIBRARIAN
  RECEPTIONIST
  ACCOUNTANT
  SCHOOL_ADMIN
}

enum PaymentMode {
  CASH
  UPI
  ONLINE
  BANK_TRANSFER
  CHEQUE
  CARD
}

enum SessionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  LOCKED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum LeaveType {
  CASUAL
  SICK
  DUTY
  MATERNITY
  PATERNITY
  UNPAID
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum FeeHeadType {
  ADMISSION
  TUITION
  HOSTEL
  TRANSPORT
  LAB
  EXAM
  SPORTS
  LIBRARY
  ACTIVITY
}

enum Permission {
  ALL
  ASSIGN_PERMISSION
  CREATE_SCHOOL
  VIEW_SCHOOL
  EDIT_SCHOOL
  DELETE_SCHOOL
  CREATE_BRANCH
  VIEW_BRANCH
  EDIT_BRANCH
  DELETE_BRANCH
  CREATE_CLASS
  VIEW_CLASS
  EDIT_CLASS
  DELETE_CLASS
  CREATE_CLASSNAME
  VIEW_CLASSNAME
  CREATE_STUDENT
  VIEW_STUDENT
  EDIT_STUDENT
  DELETE_STUDENT
  BULK_UPLOAD_STUDENTS
  GET_BULK_UPLOAD_SHEET
  CREATE_PARENT
  VIEW_PARENT
  EDIT_PARENT
  DELETE_PARENT
  CREATE_FEE_HEAD
  VIEW_FEE_HEAD
  EDIT_FEE_HEAD
  DELETE_FEE_HEAD
  CREATE_FEE_TEMPLATE
  VIEW_FEE_TEMPLATE
  EDIT_FEE_TEMPLATE
  DELETE_FEE_TEMPLATE
  GENERATE_FEE_DOCS
  VIEW_FEE_DOCS
  EDIT_FEE_DOC
  DELETE_FEE_DOC
  CREATE_FEE_PAYMENT
  VIEW_FEE_PAYMENTS
  EDIT_FEE_PAYMENT
  DELETE_FEE_PAYMENT
  CREATE_FEE_TRANSACTION
  VIEW_FEE_TRANSACTIONS
  VIEW_BRANCH_FEE_REPORT
  CREATE_SESSION
  VIEW_SESSION
  EDIT_SESSION
  DELETE_SESSION
  LOCK_SESSION
  PROMOTE_STUDENTS
  VIEW_REPORTS
  EXPORT_REPORTS
  GENERATE_ID_CARD
  GENERATE_TRANSFER_CERTIFICATE
  UPLOAD_DOCUMENT
  VIEW_DOCUMENT
  DELETE_DOCUMENT
  SEND_NOTIFICATION
  VIEW_NOTIFICATIONS
  DELETE_NOTIFICATION
  CREATE_DISCOUNT_POLICY
  VIEW_DISCOUNT_POLICY
  UPDATE_DISCOUNT_POLICY
  DELETE_DISCOUNT_POLICY
  APPLY_DISCOUNT
  DELETE_APPLY_DISCOUNT
  VIEW_APPLY_DISCOUNT
  GET_CUSTOM_FIELD
  CREATE_CUSTOM_FIELD
  UPDATE_CUSTOM_FIELD
  DELETE_CUSTOM_FIELD
  REORDER_CUSTOM_FIELD

  CREATE_FACULTY
  VIEW_FACULTY
  EDIT_FACULTY
  DELETE_FACULTY

  CREATE_SECTION
  VIEW_SECTION
  EDIT_SECTION
  DELETE_SECTION

  CREATE_SUBJECT
  VIEW_SUBJECT
  EDIT_SUBJECT
  DELETE_SUBJECT
}

enum ClassEnum {
  NURSERY
  LKG
  UKG
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH
  SIXTH
  SEVENTH
  EIGHTH
  NINTH
  TENTH
  ELEVENTH
  TWELFTH
}

enum ENTITES {
  STUDENT
  TEACHER
  PARENT
  USER
}

enum customFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  DATETIME
  EMAIL
  PHONE
  BOOLEAN
  SELECT
  MULTISELECT
  RADIO
  CHECKBOX
  FILE
  IMAGE
  URL
  CURRENCY
  PERCENTAGE
  RATING
  COLOR
  JSON
}

enum FeePaymentType {
  MONTHLY
  INSTALLMENT
  ONE_TIME
}

enum AttendanceMode {
  DAYWISE
  PERIODWISE
  BOTH
}

enum SchoolDayType {
  WORKING
  NON_WORKING
  HOLIDAY
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum AttendanceMethod {
  MANUAL
  QR
  BIOMETRIC
  GPS
}

enum AttendanceType {
  DAYWISE
  PERIODWISE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum LectureStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  BLOCKED
  REOPENED_BY_ADMIN
  CANCELLED
}


enum FieldCategory {
  RAW
  SUMMARY
  COMPUTED
  CUSTOM
}

enum RegistryDataType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  JSON
  ENUM
  RELATION_ID
  MONEY
  PERCENTAGE
}

enum FieldResolverType {
  COLUMN
  RELATION
  AGGREGATE
  EXPRESSION
  CUSTOM_FIELD
  STATIC
}

enum SourceModule {
  STUDENT
  CLASS
  ENROLLMENT
  ATTENDANCE
  FEE
  PARENT
  EXAM
  TRANSPORT
  ACADEMIC
  SYSTEM
}

model FieldRegistry {
  id                 String            @id @default(cuid())
  fieldKey           String            @unique
  label              String
  description        String?

  sourceModule       SourceModule
  sourceTable        String
  sourceColumn       String?

  fieldCategory      FieldCategory     @default(RAW)
  dataType           RegistryDataType
  enumName           String?

  resolverType       FieldResolverType @default(COLUMN)
  resolverConfig     Json?

  isFilterable       Boolean           @default(true)
  isSortable         Boolean           @default(true)
  isExportable       Boolean           @default(true)
  isVisibleInPicker  Boolean           @default(true)

  isSystemField      Boolean           @default(true)
  isCustom           Boolean           @default(false)
  isActive           Boolean           @default(true)
  deprecatedAt       DateTime?

  branchId           String?
  schoolId           String?

  groupKey           String?
  displayOrder       Int               @default(0)

  requiredPermission Permission?

  schemaVersion      Int               @default(1)
  seededFrom         String?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([sourceModule, isActive])
  @@index([branchId, isCustom])
  @@index([groupKey])
}




