// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  SUPERADMIN
  DIRECTOR
  PRINCIPAL
  TEACHER
  LIBRARIAN
  RECEPTIONIST
  ACCOUNTANT
  SCHOOL_ADMIN
  STUDENT
  FATHER
  MOTHER
}
enum PaymentMode {
  CASH
  UPI
  ONLINE
  BANK_TRANSFER
  CHEQUE
  CARD
}
enum SessionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  LOCKED
}
enum LeaveType {
  CASUAL
  SICK
  DUTY
  MATERNITY
  PATERNITY
  UNPAID
}

enum FeeHeadType {
  ADMISSION
  TUITION
  HOSTEL
  TRANSPORT
  LAB
  EXAM
  SPORTS
  LIBRARY
  ACTIVITY
}
enum Permission {
  ALL
  // School
  CREATE_SCHOOL
  VIEW_SCHOOL
  EDIT_SCHOOL
  DELETE_SCHOOL

  // Branch
  CREATE_BRANCH
  VIEW_BRANCH
  EDIT_BRANCH
  DELETE_BRANCH

  // Class
  CREATE_CLASS
  VIEW_CLASS
  EDIT_CLASS
  DELETE_CLASS

  // Student
  CREATE_STUDENT
  VIEW_STUDENT
  EDIT_STUDENT
  DELETE_STUDENT
  BULK_UPLOAD_STUDENTS

  // Parent
  CREATE_PARENT
  VIEW_PARENT
  EDIT_PARENT
  DELETE_PARENT

  // Fees
  CREATE_FEE_DOC
  VIEW_FEE_DOC
  EDIT_FEE_DOC
  DELETE_FEE_DOC
  RECORD_FEE_TRANSACTION
  VIEW_FEE_SUMMARY

  // Session
  CREATE_SESSION
  VIEW_SESSION
  EDIT_SESSION
  LOCK_SESSION
  PROMOTE_STUDENTS

  // Reports
  VIEW_REPORTS
  EXPORT_REPORTS

  // Documents
  GENERATE_ID_CARD
  GENERATE_TRANSFER_CERTIFICATE

  // Notifications
  SEND_NOTIFICATION
  VIEW_NOTIFICATIONS
}
enum ClassEnum {
  NURSERY
  LKG
  UKG
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH
  SIXTH
  SEVENTH
  EIGHTH
  NINTH
  TENTH
  ELEVENTH
  TWELFTH
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  password     String
  role         Role[]   @default([])     // ENUM: ADMIN | DIRECTOR | PRINCIPAL | TEACHER | LIBRARIAN | STUDENT | PARENT
  permissions  Permission[] @default([])
  createdAt    DateTime @default(now())
  isPhoneVerified      Boolean
  isEmailVerified      Boolean
  // Relationships
  directorSchools     School[]       @relation("DirectorSchools")
  principalAssignment Branch?        @relation("PrincipalBranch")
  teacherClasses      ClassTeacher[]
  studentProfile      Student?       
   parents            Parent[]
  feeTransactions     FeeTransaction[]
}

model School {
  id         String   @id @default(uuid())
  name       String
  createdBy  User     @relation("DirectorSchools", fields: [createdById], references: [id])
  createdById String

  branches   Branch[]
}

model Branch {
  id         String   @id @default(uuid())
  name       String
  address    String
  school     School   @relation(fields: [schoolId], references: [id])
  schoolId   String
  logoUrl    String?
  principal  User?    @relation("PrincipalBranch", fields: [principalId], references: [id])
  principalId String? @unique
  classes    Class[]
  students    Student[]
  academicSession AcademicSession[]
}


model Student {
  id                   String   @id @default(uuid())
  user                 User     @relation(fields: [userId], references: [id])
  userId               String   @unique
  studentId            String?

  branchId             String 
  branch               Branch   @relation(fields: [branchId], references: [id])
  rollNo               String

  // ----- Personal Details -----
  admissionNo          String?
  class                ClassEnum?
  section              String?
  gender               String?
  dob                  DateTime?
  aadhaar              String?
  birthCertificateUrl  String?
  abcId                String?
  sssmId               String?
  familySssmId         String?
  minority             String?
  scStObc              String?
  bpl                  String?
  scStObcCertificateUrl String?
  bplCertificateUrl    String?
  specialChild         Boolean? @default(false)
  allergies            String?
  studentEmail         String?
  studentMobile        String?
  citizenship          String?
  visaNo               String?
  visaType             String?
  visaValidity         DateTime?

  // ----- Previous Education -----
  previousSchoolName   String?
  previousClassPassed  String?
  previousClassMarks   String?
  previousClassYear    String?
  previousBoard        String?
  migrationCertificateUrl String?
  tcNo                 String?

  // ----- Address -----
  permanentAddress     String?
  temporaryAddress     String?

  // ----- Father Details -----
  fatherName           String?
  fatherOccupation     String?
  fatherEmail          String?
  fatherMobile         String?
  fatherAadhaar        String?
  fatherIdUrl          String?
  fatherPan            String?
  fatherPassport       String?
  fatherCitizenship    String?
  fatherVisaNo         String?
  fatherVisaType       String?
  fatherVisaValidity   DateTime?

  // ----- Mother Details -----
  motherName           String?
  motherOccupation     String?
  motherEmail          String?
  motherMobile         String?
  motherAadhaar        String?
  motherIdUrl          String?
  motherPan            String?
  motherPassport       String?
  motherCitizenship    String?
  motherVisaNo         String?
  motherVisaType       String?
  motherVisaValidity   DateTime?

  // ----- Fees -----
  discount             Float    @default(0)
  lateFine             Float    @default(0)
  remark               String?

  // Current year fee tracking
  currentYearTotal         Float    @default(0)
  currentYearTotalPaid     Float    @default(0)
  currentYearTotalBalance  Float    @default(0)

  // Last year fee tracking
  lastYearTotal            Float    @default(0)
  lastYearTotalPaid        Float    @default(0)
  lastYearTotalBalance     Float    @default(0)

  // ----- Extras -----
  result                Json?
  resultStatus          String?
  photoUrl              String?
  barcodeUrl            String?

  // Relationships
  feeDocs               FeeDoc[]
  feeTransactions       FeeTransaction[]
  enrollments           Enrollment[]
  fatherId              String?
  father                Parent?   @relation("fatherToStudent", fields: [fatherId], references: [id])
  motherId              String?
  mother                Parent?   @relation("motherToStudent", fields: [motherId], references: [id])
}

model Parent {
  id     String @id @default(uuid())
  type   String // "FATHER" or "MOTHER"
  userId String
  user   User   @relation(fields: [userId], references: [id])

  fatherOf Student[] @relation("fatherToStudent")
  motherOf Student[] @relation("motherToStudent")
}
model Class {
  id              String   @id @default(uuid())
  name            ClassEnum
  branch          Branch   @relation(fields: [branchId], references: [id])
  branchId        String
  classTeacher    ClassTeacher[]
  enrollments     Enrollment[]
  section         String
}

model ClassTeacher {
  classId String
  teacherId String

  class   Class @relation(fields: [classId], references: [id])
  teacher User  @relation(fields: [teacherId], references: [id])

  @@id([classId, teacherId]) // composite key
}
model FeeDoc {
  id              String   @id @default(uuid())
  student         Student  @relation(fields: [studentId], references: [id])
  studentId       String

  session         AcademicSession @relation(fields: [sessionId], references: [id])
  sessionId       String

  admissionFee    Float
  tuitionFee      Float
  transportFee    Float?
  hostelFee       Float?
  concessions     Float   @default(0)

  totalPayable    Float   // derived from above
  paidInSession   Float   @default(0)  // updated when payment made for current year
  dueInSession    Float   // totalPayable - paidInSession

  createdAt       DateTime @default(now())
}

model FeeTransaction {
  id            String   @id @default(uuid())
  student       Student  @relation(fields: [studentId], references: [id])
  studentId     String

  amountPaid    Float
  paidOn        DateTime @default(now())
  remarks       String?
  mode          PaymentMode
  referenceId   String?

  appliedToDocIds String[] @default([]) // optional JSON array to store docIds it affected
  createdBy     User      @relation(fields: [createdById], references: [id])
  createdById   String
}
model AcademicSession {
  id         String    @id @default(uuid())
  name       String    // e.g., "2025–26"
  branch     Branch    @relation(fields: [branchId], references: [id])
  branchId   String
  isCurrent  Boolean   @default(false)
  isLocked   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  enrollments Enrollment[]
  feeDocs    FeeDoc[]
}

model Enrollment {
  id         String    @id @default(uuid())
  student    Student   @relation(fields: [studentId], references: [id])
  studentId  String

  class      Class     @relation(fields: [classId], references: [id])
  classId    String

  session    AcademicSession @relation(fields: [sessionId], references: [id])
  sessionId  String

  rollNo     String?
  isPromoted Boolean   @default(false)
  createdAt  DateTime  @default(now())
}
