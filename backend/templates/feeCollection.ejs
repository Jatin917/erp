<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8"/>
  <title>Fee Card</title>
  <style>
    @page { size: A4 landscape; margin: 20mm 10mm 15mm 10mm; }
    body { font-family: Arial; font-size: 11px; }
    .header { text-align: center; margin-bottom: 10px; font-size: 13px; }
    .school-logo { width: 60px; height:60px; vertical-align: middle; margin-right: 12px; }
    .school-header { display: flex; align-items: center; justify-content: center; margin-bottom: 4px;}
    .school-info { text-align: center; font-size: 12px; margin-bottom: 6px;}
    .fee-info-table { width: 100%; border-collapse: collapse; margin: 0.5rem 0; font-size: 10.5px; }
    th, td { border: 1px solid #bbb; padding: 4px 7px; }
    .summary { margin: 0.5rem 0; font-size: 11px; }
    h2 { font-size: 18px; margin-bottom: 6px; }
    .signature-row { margin-top: 30px; display: flex; justify-content: flex-end; }
    .sign-label { margin-top: 36px; text-align: right; font-size: 12px;}
    .footer { margin-top: 25px; text-align: right; color: #555; font-size: 11px;}
    .break { height: 20px; }
  </style>
  <style>
    .primaryColor { 
      color: <%= (school.accentHex && /^#[0-9A-Fa-f]{6}$|^[0-9A-Fa-f]{3}$|^rgb\(\d{1,3}, \d{1,3}, \d{1,3}\)$/.test(school.accentHex) ? school.accentHex : '#000000') %> !important; }
  </style>
  
  
</head>
<body>
  <div class="header">
    <div class="school-header">
      <% if (school && school.logo) { %>
        <img class="school-logo" src="<%= school.logo %>" alt="School Logo"/>
      <% } %>
      <div>
        <h2 class="primaryColor"><%= school ? school.name : '' %></h2>
      </div>
    </div>
    <% if (school) { %>
      <div class="school-info">
        <span><strong>Address:</strong> <%= school.address %></span><br/>
        <span><strong>Contact:</strong> <%= school.phone %></span>
        <span><strong>Email:</strong> <%= school.email %></span>
      </div>
    <% } %>
    <div><strong class="primaryColor">Fee Card</strong></div>
    <% if (student && student.photoUrl) { %>
      <img class="school-logo" src="<%= student.photoUrl %>" alt="Student Photo"/>
    <% } %>
  </div>

 <div class="summary">
  <% if (student) { %>
    <strong>Student Name:</strong> <%= student.name %>
    &nbsp;|&nbsp;<strong>Admission No:</strong> <%= student.admissionNo %>
    &nbsp;|&nbsp;<strong>Class:</strong> <%= student.class %> - <%= student.section %>
    &nbsp;|&nbsp;<strong>Session:</strong> <%= student.session %><br>

    <!-- <strong class="primaryColor">Admission Fee:</strong> ₹<%= admissionFee || 0 %>
    &nbsp;|&nbsp;<strong class="primaryColor">Yearly Fees Total:</strong> ₹<%= yearlyFeeTotal || 0 %>
     &nbsp;|&nbsp;<strong class="primaryColor">Monthly Fees Total:</strong> ₹<%= monthlyFeeTotal || 0 %><br> -->

    <strong class="primaryColor">Total Payable:</strong> ₹<%= totalPayableYearly || 0 %>
    &nbsp;|&nbsp;<strong class="primaryColor">Total Paid:</strong> ₹<%= totalPaid || 0 %>
    &nbsp;|&nbsp;<strong class="primaryColor">Total Balance:</strong> ₹<%= totalBalance || 0 %>
  <% } else { %>
    <div style="color: red;">No student data found</div>
  <% } %>
</div>

  <% if (feeTransaction && feeTransaction.length) { %>
    <table class="fee-info-table" border="1" cellspacing="0" cellpadding="5" width="100%">
      <thead>
        <tr>
          <th>Date</th>
          <th>System Txn ID</th>
          <th>Payer Txn ID</th>
          <th>Mode</th>
          <th>Amount</th>
          <th>Total Paid</th>
          <th>Balance</th>
          <th>Received By</th>
        </tr>
      </thead>
      <tbody>
        <% feeTransaction.forEach(n => { %>
          <tr>
            <td><%= new Date(n.createdAt).toLocaleDateString() %></td>
            <td><%= n.refereceId %></td>
            <td><%= n.userTxnId || '' %></td>
            <td><%= n.mode %></td>
            <td>₹<%= n.amountPaid %></td>
            <!-- <td>₹<%= n.student.lastYearTotalPaid+n.student. %></td>
            <td>₹<%= n.totalBalance %></td> -->
            <td><%= n.createdBy.name || '' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <div>No fee transactions found.</div>
  <% } %>

  <div class="signature-row">
    <div class="sign-label">
      <br><br>
      Signature<br>
      (Received By: <%= feeTransaction && feeTransaction.length ? feeTransaction[feeTransaction.length-1].createdBy.name : '' %>)
    </div>
  </div>

  <div class="footer">
    Printed on: <%= new Date().toLocaleString() %>
  </div>
</body>
</html>
