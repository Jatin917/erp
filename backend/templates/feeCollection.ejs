<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fee Payment Receipt - <%= student.name %></title>
    <style>
      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        margin: 40px;
        background-color: #fff;
        color: #222;
      }

      .receipt-container {
        border: 2px solid #333;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 0 8px rgba(0, 0, 0, 0.1);
      }

      .receipt-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .school-logo img {
        height: 80px;
        width: auto;
      }

      .school-name {
        text-align: center;
      }

      .school-name h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
      }

      .school-name p {
        margin: 4px 0 0;
        font-size: 0.9rem;
        color: #666;
      }

      .student-photo img {
        height: 80px;
        width: 80px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid #ccc;
      }

      hr {
        margin: 20px 0;
        border: none;
        border-top: 1px solid #ccc;
      }

      .section {
        margin-bottom: 15px;
      }

      .section h3 {
        margin-bottom: 8px;
        color: #333;
        border-bottom: 1px solid #ddd;
        padding-bottom: 4px;
      }

      .info-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        margin-bottom: 4px;
      }

      .info-row p {
        margin: 4px 0;
        width: 48%;
      }

      .principal-info {
        text-align: right;
        margin-top: 40px;
      }

      .principal-info img {
        height: 60px;
        width: auto;
        margin-bottom: 5px;
      }

      .footer {
        text-align: center;
        font-size: 0.85rem;
        margin-top: 30px;
        color: #555;
      }
    </style>
  </head>
  <body>
    <div class="receipt-container">
      <!-- HEADER -->
      <div class="receipt-header">
        <div class="school-logo">
          <% if (school.logo) { %>
            <img src="<%= school.logo %>" alt="School Logo" />
          <% } %>
        </div>

        <div class="school-name">
          <h2><%= school.name %></h2>
          <p>Fee Payment Receipt</p>
        </div>

        <div class="student-photo">
          <% if (student.photo) { %>
            <img src="<%= student.photo %>" alt="Student Photo" />
          <% } %>
        </div>
      </div>

      <hr />

      <!-- STUDENT INFO -->
      <div class="section">
        <h3>Student Details</h3>
        <div class="info-row">
          <p><strong>Name:</strong> <%= student.name %></p>
          <p><strong>Admission No:</strong> <%= student.admissionNo %></p>
        </div>
        <div class="info-row">
          <p><strong>Class:</strong> <%= student.class %></p>
          <p><strong>Session:</strong> <%= student.session %></p>
        </div>
      </div>

      <!-- TRANSACTION INFO -->
      <div class="section">
        <h3>Transaction Details</h3>
        <div class="info-row">
          <p><strong>Receipt No:</strong> <%= transaction?.receiptNo || 'N/A' %></p>
          <p><strong>Amount Paid:</strong> ₹<%= transaction?.amountPaid?.toFixed(2) || '0.00' %></p>
        </div>
        <div class="info-row">
          <p><strong>Payment Date:</strong> <%= transaction?.paidOn ? new Date(transaction.paidOn).toLocaleDateString() : 'N/A' %></p>
          <p><strong>Mode:</strong> <%= transaction?.mode || 'N/A' %></p>
        </div>
        <% if (transaction?.remarks) { %>
          <p><strong>Remarks:</strong> <%= transaction.remarks %></p>
        <% } %>
      </div>

<!-- PAYMENT DETAILS -->
<div class="section">
  <h3>Payment Breakdown</h3>
  <% if (transaction?.items && transaction.items.length > 0) { %>
    <table style="width:100%; border-collapse: collapse;">
      <thead>
        <tr>
          <th style="border: 1px solid #ccc; padding:4px;">Fee Name</th>
          <th style="border: 1px solid #ccc; padding:4px;">Allocated Amount (₹)</th>
          <th style="border: 1px solid #ccc; padding:4px;">Paid Amount (₹)</th>
          <th style="border: 1px solid #ccc; padding:4px;">Fine Amount (₹)</th>
        </tr>
      </thead>
      <tbody>
        <% transaction.items.forEach(item => { %>
          <tr>
            <td style="border: 1px solid #ccc; padding:4px;"><%= item.feePayment?.name || 'N/A' %></td>
            <td style="border: 1px solid #ccc; padding:4px;"><%= item.allocatedAmount?.toFixed(2) || '0.00' %></td>
            <td style="border: 1px solid #ccc; padding:4px;"><%= item.transaction?.amountPaid?.toFixed(2) || '0.00' %></td>
            <td style="border: 1px solid #ccc; padding:4px;"><%= item.feePayment?.fineAmount?.toFixed(2) || '0.00' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No payment allocations available.</p>
  <% } %>
</div>

      <!-- PRINCIPAL INFO -->
      <div class="principal-info">
        <% if (school.principalSignature) { %>
          <img src="<%= school.principalSignature %>" alt="Principal Signature" />
        <% } %>
        <p><strong><%= school.principalName || 'Principal' %></strong></p>
        <p>Principal</p>
      </div>

      <div class="footer">
        <p>Generated on <%= new Date().toLocaleDateString() %>. This is a system-generated receipt.</p>
      </div>
    </div>
  </body>
</html>
